# Non-secret settings only. Copy to .env on the deployment host and fill the <...> placeholders.
# Secrets (Discord token, database passwords) are NOT set here; the Owner places them as files in JB_SECRET_DIR:
#   discord_bot_token.txt, db_password.txt (Bot app role), db_migrator_password.txt (migrator role, used only by `migrate`).

# External PostgreSQL 18. DB_HOST must match the server certificate (DB_SSLMODE=verify-full verifies the host name).
DB_HOST=<external-postgresql-host-name>
DB_PORT=5432
DB_NAME=jukebox101
DB_USER=jukebox101_app
DB_MIGRATION_USER=jukebox101_migrator
DB_SSLMODE=verify-full
# PEM CA bundle that signed the PostgreSQL server certificate (public, not secret). For a public CA you may point this
# at the host's system bundle file; libpq 15 in the image does not support sslrootcert=system.
JB_DB_CA_FILE=<path-to-postgresql-server-ca.pem>

# Discord: one application, one Owner. Commands work in every guild that installed the Bot via the invite link.
DISCORD_EXPECTED_APPLICATION_ID=<application-id>
DISCORD_OWNER_USER_ID=<owner-user-id>
# Optional: the one guild where Owner review commands are registered. Leave empty to use only the Owner CLI.
DISCORD_OWNER_GUILD_ID=

JB_SECRET_DIR=<host-directory-with-secret-files>
JUKEBOX_FORMAL_EXCHANGE=off
JUKEBOX_NICKEL_CLAIM=off

# Automatic review and settlement stay off unless compose.auto-review.yaml is added; see docs/deploy/auto-review-nickel-enable.md.
JUKEBOX_AUTO_REVIEW=off
JUKEBOX_AUTO_SETTLEMENT=off
# API data lifecycle: on keeps official API values only in a short-lived table and runs the purge (needs migration 0004); see docs/api-retention-release.md.
# JUKEBOX_AUTO_REVIEW=on refuses to start unless this is on.
JUKEBOX_API_RETENTION=off
# Owner-approved stable channel IDs (UC...), comma separated. Empty approves nothing automatically.
YOUTUBE_TRUSTED_CHANNEL_IDS=
