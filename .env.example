DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jukebox101_app
DB_PASSWORD=
DB_NAME=jukebox101
DISCORD_BOT_TOKEN=
# Explicit startup reads environment only; no automatic command synchronization.
# Never place TEST_DB_*, TEST_MIGRATION_DB_*, TEST_HARNESS_DB_* or TEST_DBA_* credentials here.
# Test, migration and Harness credentials are supplied only as process environment; never through DB_TESTAPP_*, DB_*_migrator_* or DB_HARNESS_* keys.
# See docs/mysql-test-preparation.md.

# Private Guild startup requires explicit IDs; missing values fail before login.
DISCORD_DEV_GUILD_ID=
DISCORD_EXPECTED_APPLICATION_ID=
DISCORD_OWNER_USER_ID=
