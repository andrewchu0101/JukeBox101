#!/bin/bash
# JukeBox101 host deploy: the only command the restricted SSH key can run (via sudo -n, no arguments).
# stdin, one line:  deploy-v2 <commit> <image digest> <run id> <run attempt>
# stdout, one word: succeeded | rolled_back | rollback_failed | rejected | running
# stderr, free text for people: why a request was refused or a release failed. The workflow log is public, so
# these are fixed sentences only; raw docker output goes to $STATE/last-compose-failure.log on the host.
# Same run+attempt is idempotent, so the workflow may simply send it again after a dropped connection.
# JB_* variables exist for tests only; sudo clears the caller's environment, so SSH cannot set them.
set -euo pipefail
export PATH=/usr/bin:/bin DOCKER_HOST=unix:///var/run/docker.sock
umask 077

STATE=${JB_STATE_DIR:-/var/lib/jukebox101-deploy}
COMPOSE=${JB_COMPOSE_FILE:-/etc/jukebox101/compose.cd.yaml}
ENVFILE=${JB_ENV_FILE:-/etc/jukebox101/bot.env}
CONF=${JB_CONF_FILE:-/etc/jukebox101/deploy.conf}
DOCKER=${JB_DOCKER:-/usr/bin/docker}
OWNER_UID=${JB_OWNER_UID:-0}
START_TIMEOUT=${JB_START_TIMEOUT:-180}
SOAK_SECONDS=${JB_SOAK_SECONDS:-60}
SOAK_STEP=${JB_SOAK_STEP:-5}
FLOCK=${JB_FLOCK:-/usr/bin/flock}
YOUTUBE_KEY_FILE=${JB_SECRET_DIR:-/etc/jukebox101/secrets}/youtube_api_key.txt
IMAGE=ghcr.io/andrewchu0101/jukebox101
SOURCE=https://github.com/andrewchu0101/JukeBox101
ROLLBACK_TAG=jukebox101-rollback:previous
export DOCKER_CONFIG="$STATE/docker"
trap '' HUP PIPE # a dropped SSH session must never interrupt a half-finished switch

commit= digest= run= attempt= emitted= disrupted=

say() { printf '%s\n' "$1" || true; }

why() { printf 'jukebox101-deploy: %s\n' "$1" >&2 || true; }

emit() { # record the terminal result durably, then print it
  emitted=1
  if [ -n "$commit" ]; then
    printf '%s %s %s\n' "$1" "$commit" "$digest" > "$STATE/results/$run-$attempt.tmp"
    mv "$STATE/results/$run-$attempt.tmp" "$STATE/results/$run-$attempt"
  fi
  say "$1"
  [ "$1" != rejected ] || exit 2
  exit 0
}

on_exit() { # an unexpected crash is reported honestly: after the old Bot was stopped it needs a human
  [ -n "$emitted" ] || { why 'unexpected script failure'; [ -n "$disrupted" ] && touch "$STATE/locked"; emit "$([ -n "$disrupted" ] && echo rollback_failed || echo rejected)"; }
}
trap on_exit EXIT

setting() { { sed -n "s/^$1=//p" "$2" 2> /dev/null || true; } | head -n 1 | tr -d "\"'"; } # missing file = empty

owned() { # root-owned and not writable by group/others
  [ -f "$1" ] && [ -z "$(find "$1" -maxdepth 0 \( ! -user "$OWNER_UID" -o -perm -g+w -o -perm -o+w \))" ]
}

youtube_key_ready() { # a compose file that mounts the YouTube key needs the file before anything is stopped; only existence is checked
  grep -q 'youtube_api_key' "$COMPOSE" || return 0
  [ -f "$YOUTUBE_KEY_FILE" ] || { why "compose file mounts youtube_api_key but $YOUTUBE_KEY_FILE is not a regular file; create it (uid/gid 10001, mode 0400) first"; return 1; }
}

gateways() { # running containers of this Discord application (plus the optional legacy container)
  { "$DOCKER" ps -q --filter "label=com.jukebox101.gateway.application=$app_id"
    [ -z "$legacy" ] || "$DOCKER" ps -q --filter "name=^/${legacy}\$"
  } | sort -u
}

compose_run() { # $1 image ref, then compose arguments
  local image=$1; shift
  env JB_IMAGE="$image" "$DOCKER" compose --project-name jukebox101 --env-file "$ENVFILE" --file "$COMPOSE" "$@"
}

stop_all() {
  local ids; ids=$(gateways)
  [ -z "$ids" ] || "$DOCKER" stop --time 30 $ids > /dev/null
  compose_run "$ref" stop --timeout 30 bot > /dev/null 2>&1 || true
  [ -z "$(gateways)" ] || { why 'a Gateway container is still running after stop'; return 1; }
}

stable() { # one Gateway, healthy, and the same container with no restarts for the whole soak window
  local id first now i
  id=$(gateways); [ "$(printf '%s' "$id" | wc -w)" -eq 1 ] || { why 'expected exactly one running Gateway container after start'; return 1; }
  first=$("$DOCKER" inspect --format '{{.Id}} {{.State.Running}} {{.State.Health.Status}} {{.RestartCount}}' "$id")
  [[ $first == *' true healthy '* ]] || { why "container is not running and healthy: $first"; return 1; }
  for ((i = 0; i < SOAK_SECONDS / SOAK_STEP; i++)); do
    sleep "$SOAK_STEP"
    now=$("$DOCKER" inspect --format '{{.Id}} {{.State.Running}} {{.State.Health.Status}} {{.RestartCount}}' "$id") || { why 'container disappeared during the observation window'; return 1; }
    [ "$now" = "$first" ] || { why "container changed during the observation window: $first -> $now"; return 1; }
  done
}

start_release() { # $1 image ref
  local output status=0
  output=$(compose_run "$1" up --detach --no-deps --no-build --pull never --wait --wait-timeout "$START_TIMEOUT" bot 2>&1 > /dev/null) || status=$?
  if [ "$status" -ne 0 ]; then
    printf '%s\n' "$output" > "$STATE/last-compose-failure.log"
    why "docker compose up failed (exit $status); read $STATE/last-compose-failure.log on the host"
    return 1
  fi
  stable
}

admit() { # every check here runs before anything is stopped
  local highwater; highwater=$(cat "$STATE/highwater" 2> /dev/null || echo 0)
  [ ! -e "$STATE/locked" ] || { why "host is locked after a failed rollback; check the Bot, then remove $STATE/locked"; return 1; }
  owned "$COMPOSE" || { why 'compose file must be a root-owned regular file that group and others cannot write'; return 1; }
  owned "$ENVFILE" || { why 'bot.env must be a root-owned regular file that group and others cannot write'; return 1; }
  youtube_key_ready || return 1
  [[ $app_id =~ ^[0-9]+$ ]] || { why 'DISCORD_EXPECTED_APPLICATION_ID is missing or not numeric in bot.env'; return 1; }
  [ "$run" -gt "$highwater" ] || { why "run $run is not newer than the highest deployed run $highwater; push a new commit instead of re-running"; return 1; }
  "$DOCKER" pull "$ref" > /dev/null 2>&1 || { why "cannot pull $ref"; return 1; }
  [ "$("$DOCKER" image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}} {{index .Config.Labels "org.opencontainers.image.source"}} {{.Config.User}}' "$ref")" = "$commit $SOURCE 10001:10001" ] ||
    { why 'image labels do not match the requested commit, this repository and user 10001:10001'; return 1; }
  [ "$(gateways | wc -l)" -le 1 ] || { why 'more than one Gateway container is already running for this application'; return 1; }
}

main() {
  local line request_pattern='^deploy-v2 ([a-f0-9]{40}) (sha256:[a-f0-9]{64}) ([1-9][0-9]{0,19}) ([1-9][0-9]{0,5})$'
  IFS= read -r -t 5 -n 257 line || true
  [[ ${#line} -le 256 && $line =~ $request_pattern ]] || { why 'request is not exactly: deploy-v2 <commit> <digest> <run> <attempt>'; emit rejected; }
  commit=${BASH_REMATCH[1]} digest=${BASH_REMATCH[2]} run=${BASH_REMATCH[3]} attempt=${BASH_REMATCH[4]}
  ref=$IMAGE@$digest
  mkdir -p "$STATE/results" "$DOCKER_CONFIG"
  exec 9> "$STATE/lock"
  "$FLOCK" -n 9 || { emitted=1; say running; exit 0; }
  if [ -f "$STATE/results/$run-$attempt" ]; then
    read -r saved_status saved_commit saved_digest < "$STATE/results/$run-$attempt"
    emitted=1; [ "$saved_commit $saved_digest" = "$commit $digest" ] && say "$saved_status" || { why "run $run attempt $attempt was already answered for a different request"; say rejected; }; exit 0
  fi
  app_id=$(setting DISCORD_EXPECTED_APPLICATION_ID "$ENVFILE") legacy=$(setting LEGACY_CONTAINER "$CONF")
  [[ -z $legacy || $legacy =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || { why 'LEGACY_CONTAINER in deploy.conf is not a valid container name'; emit rejected; }
  admit || emit rejected
  ls -1t "$STATE/results" | tail -n +201 | while read -r old; do rm -f -- "$STATE/results/$old"; done
  switch_release
}

switch_release() {
  local ids rollback_ready=
  ids=$(gateways)
  # Keep the exact image that is running now: it is the rollback target, even if it was never in the registry.
  [ -z "$ids" ] || "$DOCKER" tag "$("$DOCKER" inspect --format '{{.Image}}' $ids)" "$ROLLBACK_TAG"
  ! "$DOCKER" image inspect "$ROLLBACK_TAG" > /dev/null 2>&1 || rollback_ready=1
  echo "$run" > "$STATE/highwater"
  disrupted=1
  if stop_all && start_release "$ref"; then echo "$digest" > "$STATE/current"; emit succeeded; fi
  why "new release failed${rollback_ready:+; restoring the previous image}"
  if [ -n "$rollback_ready" ] && stop_all && start_release "$ROLLBACK_TAG"; then emit rolled_back; fi
  why "no running Bot could be restored; host is locked until $STATE/locked is removed"
  touch "$STATE/locked" # a failed rollback needs a person; no further deploy until they remove this file
  emit rollback_failed
}

main
