# REVIEW ONLY. Outside .github/workflows. Publishing and CD are intentionally disabled.
# Requires an independently verified receipt, reviewed image digests, production adapter,
# protected main, GHCR authorization and separate explicit production enablement.
name: Reviewed release proposal
'on':
  workflow_dispatch:
permissions: {}
jobs:
  publish:
    if: false
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09
        with:
          persist-credentials: false
      # Candidate must be built ONCE, then pass the same offline + exact-runtime
      # PG/TLS checks in ci.yml. Push that already-tested local IMAGE ID/tag only.
      # Never rebuild after tests. Bind registry digest and source to a verified receipt.
      - name: Fail closed pending release trust implementation
        run: exit 1
  deploy:
    if: false
    needs: publish
    runs-on: ubuntu-24.04
    permissions: {}
    environment: production
    concurrency:
      group: jukebox101-production
      cancel-in-progress: false
    steps:
      # No checkout or unverified host command. No SSH or secrets configured yet.
      - name: Fail closed pending production authorization and adapter
        run: exit 1
